            "nodePositionY": 0.0,
            "displayTime": 0.0
        },
        {
            "title": "Node_Key Missing",
            "guid": "8c7843df91f1c68356e211621957a040",
            "speaker": "Veya",
            "question": "No key. I will need another approach.",
            "nodePositionX": 2300.0,
            "nodePositionY": 250.0,
            "displayTime": 0.0
        },
        {
            "title": "Node_Trust Accepted",
            "guid": "5d7fe01fb4b3bded600a6842e05a11aa",
            "speaker": "Sol",
            "question": "Your clearance is trusted. Passage granted without payment.",
            "nodePositionX": 2800.0,
            "nodePositionY": 650.0,
            "displayTime": 0.0
        },
        {
            "title": "Node_Exception Denied",
