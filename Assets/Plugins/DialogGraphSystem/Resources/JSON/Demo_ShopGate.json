    "dialogNodes": [
        {
            "title": "Node_Checkpoint Status",
            "guid": "213947b669ce78ecc7aef1ea6e243a26",
            "speaker": "Sol",
            "question": "Checkpoint rules, Veya. You carry {gold} gold; key status: {hasKey}; trust clearance: {trustLevel}.",
