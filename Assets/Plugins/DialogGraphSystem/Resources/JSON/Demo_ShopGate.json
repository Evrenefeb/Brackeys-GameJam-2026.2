            "nodePositionY": 0.0,
            "displayTime": 0.0
        },
        {
            "title": "Node_Choose An Approach",
            "guid": "4c90f48951a902a17027b2e333a44a3e",
            "speaker": "Veya",
            "question": "Then I will choose the cleanest way through.",
            "nodePositionX": 800.0,
