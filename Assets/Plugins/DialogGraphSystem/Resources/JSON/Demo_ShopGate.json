            "displayTime": 0.0
        },
        {
            "title": "Node_Payment Accepted",
            "guid": "9571e1c20cfe1378288930010d16dde0",
            "speaker": "Sol",
            "question": "Payment accepted. Remaining balance: {gold} gold. The gate is opening.",
            "nodePositionX": 2800.0,
            "nodePositionY": -700.0,
            "displayTime": 0.0
        },
        {
            "title": "Node_Insufficient Gold",
            "guid": "6bab37fbb60381f0fd0b97ca9a890775",
            "speaker": "Sol",
            "question": "Denied. Ten gold is required, and you currently have {gold}.",
            "nodePositionX": 2300.0,
            "nodePositionY": -350.0,
            "displayTime": 0.0
        },
        {
            "title": "Node_Key Accepted",
            "guid": "51c66e5cbaef7584d69a8609e2c2d42a",
            "speaker": "Sol",
            "question": "The checkpoint key is valid. Passage granted.",
